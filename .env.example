# Copia este archivo como .env y ajusta los valores. Nunca subas .env a un repositorio.

# Servidor
PORT=3000
# 127.0.0.1 = solo este equipo. Usa 0.0.0.0 para verlo desde otros dispositivos de tu red.
HOST=127.0.0.1

# Token del panel /admin. Si lo dejas vacío se genera uno aleatorio en data/admin-token.txt
ADMIN_TOKEN=

# Fuente original (páginas públicas de la cartelera)
SOURCE_BASE_URL=https://novedadestaquillas.cajondecontenido.appboxes.co/

# Sincronización
SYNC_INTERVAL_HOURS=12
# Nº de sincronizaciones seguidas sin aparecer en la fuente antes de marcar un título como "no disponible"
MISSING_THRESHOLD=2
SYNC_RETRIES=3
SYNC_RETRY_DELAY_MS=60000
# Sincronizar al arrancar si nunca se ha sincronizado o la última ya venció
SYNC_ON_START=true

# Metadatos opcionales de TMDB (título, sinopsis, reparto, temporadas, episodios...)
# Clave gratuita: https://www.themoviedb.org/settings/api  (usa UNA de las dos)
TMDB_API_KEY=
TMDB_READ_TOKEN=
TMDB_LANGUAGE=es-ES
# Días tras los que se refrescan los metadatos de un título ya enriquecido
ENRICH_REFRESH_DAYS=7
